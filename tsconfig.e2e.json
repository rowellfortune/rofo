{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "aws-lambda"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "e2e",
    "playwright.config.ts"
  ],
  "exclude": [
    "e2e/.dist",
    "e2e/.results",
    "e2e/.report"
  ]
}
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "aws-lambda",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "backend",
    "infra",
    "sst.config.ts",
    "sst-env.d.ts",
    "tests",
    "src/api",
    "src/lib",
    "src/data",
    "src/types.ts",
    "src/vite-env.d.ts"
  ]
}
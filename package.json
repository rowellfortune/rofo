{
  "name": "rofo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "sst:dev": "sst dev",
    "deploy:prod": "sst deploy --stage production",
    "seed": "sst shell --stage dev -- tsx backend/scripts/seed.ts",
    "test:backend": "SST_RESOURCE_Table={\\\"name\\\":\\\"test-table\\\"} SST_RESOURCE_App={\\\"name\\\":\\\"rofo\\\",\\\"stage\\\":\\\"test\\\"} tsx --test backend/test/pools.test.ts backend/test/geocode.test.ts backend/test/applications.test.ts backend/test/policy.test.ts",
    "test:frontend": "tsx --test tests/api.test.ts tests/agent.test.ts tests/pools.test.ts",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "aws-amplify": "^6.22.2",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sst": "3.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
